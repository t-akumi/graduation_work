<body>
  <div class="container pt-5 pb-5 d-flex">
    <div class="top_page_box mt-5 text-center">
      <h3 class="mt-3 font-weight-bold">お気に入りが見つかる<br>日用品管理アプリ</h3>
      <p class= "mt-5">このアプリは日用品のストックを管理するだけでなく、<br>
        お気に入りの商品や様々な情報を発信したり、<br>
        チェックすることができます。<br>
        他のユーザーの投稿をチェックしながら<br>
        身の回りの日用品を充実させていきましょう！
      </p>
    </div>
  </div>
  <div class= "entrance_buttons pt-5 my-5 py-5">
    <% if logged_in? %>
      <div class="responsive_buttons_entrance">
        <%= link_to articles_path, class: "responsive_entrance btn btn-default" do%>
          <div class="rooting_button px-5 py-4 ">投稿を見る</div>
        <% end %>
        <%= link_to stocks_path, class: "responsive_entrance btn btn-default" do%>
          <div class="rooting_button px-4 py-4 ">在庫を確認する</div>
        <% end %>
      </div>
    <% else %>
      <div class="responsive_buttons_entrance">
        <%= link_to articles_path, class: "responsive_entrance btn btn-default" do%>
          <div class="rooting_button p-3">投稿を見てみる<br>（ログイン不要）</div>
        <% end %>
      </div>
      <div class="responsive_buttons_entrance">
        <%= link_to login_path, class: "responsive_entrance btn btn-default" do%>
          <div class="rooting_button p-4 mr-5 ml-5">ログイン</div>
        <% end %>
        <%= link_to new_user_path, class: "responsive_entrance btn btn-default" do%>
          <div class="rooting_button p-4 ml-2">新規ユーザー登録</div>
        <% end %> 
      </div>
     
    <% end %>
  </div>

</body>