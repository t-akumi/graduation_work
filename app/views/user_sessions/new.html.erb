<%= content_for(:title,'ログインページ') %>
<div class="form_container bg-white text-dark">
  <div class="form_box mx-3 my-3">
    <div class="d-flex">
      <h3 class="mx-3 mt-4 title_user_login">ログイン画面</h3>
      <div class="external_login_button">
        <%= link_to "LINEでログイン", login_line_path(provider: "line"), class: "line_button btn btn-success" %>
      </div>
    </div>
    <div class="forms">
      <%= form_with url: login_path do |f| %>
        <div class="input_form mr-5">
          <%= f.label :メールアドレス, class: "label text-center"%>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="input_form my-5 mr-5"> 
          <%= f.label :パスワード, class: "label text-center" %>
          <%= f.text_field :password, class: "form-control" %>
        </div>  
        <%= f.submit "ログイン", class: "submit_button"%>
      <% end %>
    </div>
    

  </div>
</div>